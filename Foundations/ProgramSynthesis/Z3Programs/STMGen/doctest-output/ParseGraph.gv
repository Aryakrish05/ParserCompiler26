// Parser as State Machine
digraph ParseGraph {
	Node0 [label="Extract(field0_v_0)"]
	Node1 [label="Extract(field3_v_3)"]
	Node2 [label="Extract(field1_v_1)"]
	Node3 [label="Extract(field2_v_2)"]
	ACCEPT [label=ACCEPT]
	REJECT [label=REJECT]
	Node0 -> Node1
	Node1 -> Node3
	Node2 -> ACCEPT
	Node3 -> REJECT
	Node0 -> Node2 [label="v=0,m=21"]
}
