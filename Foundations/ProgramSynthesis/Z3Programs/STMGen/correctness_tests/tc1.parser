struct field0 { bit_5 v;bit_3 bruh; };
struct field1 { bit_1 v; bit_7 bruh;};
struct field2 { bit_1 v; bit_7 bruh;};
struct field3 { bit_2 v;bit_6 bruh; };

struct  {
    struct field0 field0;
    struct field1 field1;
    struct field2 field2;
    struct field3 field3;
} phv;

int parse() {
    Extract(phv.field0);
    if ((phv.field0.v & 15) == 3) {
        Extract(phv.field1);
    }
    else if ((phv.field0.v & 15) == 4) {
        Extract(phv.field2);
    }
    Extract(phv.field3);
    return ACCEPT;
}
