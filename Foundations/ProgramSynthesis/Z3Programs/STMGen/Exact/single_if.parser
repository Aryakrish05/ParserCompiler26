//max_packet_size = 56

struct hdr0 { bit_16 f0; };
struct hdr1 { bit_16 f1; };
struct tail { bit_8 f0; bit_16 f1; };

struct {
    struct hdr0 hdr0;
    struct tail tail;
    struct hdr1 hdr1;
} phv;

int parse() {
    Extract(phv.hdr0);
    if (phv.hdr0.f0 == 2) {
        Extract(phv.hdr1);
    }
    Extract(phv.tail);
    return ACCEPT;
}