int parse() {
    Extract(data1_f16,5);
    if (data1_f16==0) {
        Extract(ipv4_f7,1);
        Extract(ipv4_fragOffset,5);
        Extract(ipv4_ihl,5);
        Extract(ipv4_protocol,5);
        if (ipv4_fragOffset==1) {
            if (ipv4_ihl==2) {
                if (ipv4_protocol==3) {
                    Extract(tcp_f16,1);
                    return ACCEPT;
                }
                else if (ipv4_protocol==4) {
                    Extract(udp_f32,1);
                }
            }
        }
    }
    else if (data1_f16==5) {
        Extract(ipv6_f8,5);
        Extract(ipv6_f32,1);
        if (ipv6_f8==6) {
            Extract(icmp_f8,5);
        }
        else if (ipv6_f8==7) {
            Extract(tcp_f16,1);
        }
        else if (ipv6_f8==8) {
            Extract(udp_f32,1);
        }
    }
    return ACCEPT;
}